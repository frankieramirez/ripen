{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // An assets-only Worker: no `main`, so there is no script in the request
  // path -- Workers Static Assets serves the built directory directly. The
  // Astro build is `output: "static"` for the same reason.
  "name": "ripen-site",
  "compatibility_date": "2026-08-25",
  "assets": {
    // Relative to this file, so `wrangler deploy` runs from site/.
    "directory": "./dist"
  },
  // Declared, not defaulted, because `workers_dev` has a default and so an
  // absent key still asserts something: a route toggled off in the dashboard
  // and left out of this file comes back on the next deploy.
  //
  // `routes` is the opposite and there is deliberately no `routes` key here.
  // #123 measured it rather than reading the docs harder: with no `routes`
  // key a deploy touches no routing at all, which is what holds the apex up
  // today -- `ripen.dev/*` and `*.ripen.dev/*` point at this Worker, both
  // attached by hand in the dashboard and neither written down here.
  //
  // So this file does NOT yet record the routing this Worker has. #121
  // declares both of them, once the deploy token carries
  // `Workers Routes: Edit` and `Zone: Read` -- and it has to be both, because
  // the moment a `routes` key exists wrangler makes this script's routes
  // exactly the declared list and deletes the undeclared sibling.
  "workers_dev": true
}
