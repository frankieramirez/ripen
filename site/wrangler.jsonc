{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ripen-site",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "ripen.dev/*", "zone_name": "ripen.dev" },
    { "pattern": "*.ripen.dev/*", "zone_name": "ripen.dev" }
  ],
  "workers_dev": true
}
