---

<ripen-theme-toggle>
  <button type="button" class="theme-toggle">
    <span class="label">Theme: system</span>
  </button>
</ripen-theme-toggle>

<style>
  ripen-theme-toggle {
    display: inline-flex;
  }

  .theme-toggle {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    font: inherit;
    white-space: nowrap;
  }

  .theme-toggle:hover {
    border-color: var(--muted);
    color: var(--ink);
  }

  .theme-toggle .label {
    color: inherit;
  }
</style>

<script is:inline>
  (function () {
    if (window.customElements.get("ripen-theme-toggle")) return;

    var KEY = "ripen-theme";
    var order = ["system", "dark", "light"];

    function read() {
      try {
        var stored = localStorage.getItem(KEY);
        return stored === "dark" || stored === "light" ? stored : "system";
      } catch (e) {
        return "system";
      }
    }

    function render(mode) {
      document.querySelectorAll("ripen-theme-toggle").forEach(function (host) {
        var button = host.querySelector("button");
        var text = host.querySelector(".label");
        if (!button || !text) return;
        text.textContent = "Theme: " + mode;
        button.setAttribute("aria-label", "Theme: " + mode + ". Change theme.");
      });
    }

    function apply(mode) {
      if (mode === "system") {
        delete document.documentElement.dataset.theme;
        try {
          localStorage.removeItem(KEY);
        } catch (e) {}
      } else {
        document.documentElement.dataset.theme = mode;
        try {
          localStorage.setItem(KEY, mode);
        } catch (e) {}
      }
      render(mode);
    }

    window.customElements.define(
      "ripen-theme-toggle",
      class extends HTMLElement {
        connectedCallback() {
          render(read());
          var button = this.querySelector("button");
          if (!button) return;
          button.addEventListener("click", function () {
            apply(order[(order.indexOf(read()) + 1) % order.length]);
          });
        }
      },
    );
  })();
</script>
