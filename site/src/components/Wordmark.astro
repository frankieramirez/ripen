---
import Glyph from "./Glyph.astro";

interface Props {
  href?: string;
  as?: "a" | "span";
  /** Cap height of the word, in CSS pixels. The glyph is sized off it. */
  size?: number;
  class?: string;
}

const {
  href = "/",
  as = "a",
  size = 16,
  class: className,
}: Props = Astro.props;

const Tag = as;
const attrs = as === "a" ? { href, "aria-label": "Ripen, home" } : {};
---

<Tag class:list={["wordmark", className]} {...attrs} style={`--mark-size: ${size}px`}>
  <Glyph size={size * 0.62} />
  <span class="word">ripen</span>
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: var(--mark-size);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  a.wordmark:hover .word {
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.3em;
  }
</style>
