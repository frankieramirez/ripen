---
interface Props {
  /** Height in CSS pixels. Width follows the box: 32:14. */
  size?: number;
  class?: string;
}

const { size = 14, class: className } = Astro.props;
---

<svg
  class:list={["glyph", className]}
  viewBox="0 0 32 14"
  width={(size * 32) / 14}
  height={size}
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="7.5" cy="7" r="6" class="hollow"></circle>
  <circle cx="24.5" cy="7" r="7" class="filled"></circle>
</svg>

<style>
  .glyph {
    display: block;
    flex: none;
  }

  .hollow {
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
  }

  .filled {
    fill: var(--ripe);
  }
</style>
