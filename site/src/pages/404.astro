---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Wordmark from "../components/Wordmark.astro";

---

<BaseLayout
  title="Not found — Ripen"
  description="No page is served at this URL."
  noindex
>
  <header class="frame head">
    <Wordmark />
    <ThemeToggle />
  </header>

  <main class="frame miss">
    <p class="label">404</p>
    <h1>No such page.</h1>

    <p>
      Nothing is served at this URL. It may have moved, or it may never have
      been here.
    </p>

    <nav class="ways" aria-label="Where to go instead">
      <a href="/">Landing page</a>
      <a href="/docs/">Documentation</a>
    </nav>
  </main>
</BaseLayout>

<style>
  .frame {
    max-width: var(--frame);
    margin: 0 auto;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding-top: var(--space-8);
  }

  .miss {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - 10rem);
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .miss h1 {
    font-size: var(--step-title);
    line-height: var(--leading-title);
    margin-bottom: var(--space-6);
  }

  .miss .label {
    display: block;
    margin-bottom: var(--space-2);
  }

  .ways {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .ways a {
    font-family: var(--font-mono);
    font-size: var(--step-body);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
  }

  .ways a:hover {
    border-color: var(--muted);
  }

  @media (max-width: 40rem) {
    .ways {
      align-items: stretch;
      flex-direction: column;
    }

    .ways a {
      text-align: center;
    }
  }
</style>
