---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Wordmark from "../components/Wordmark.astro";
import Snippet from "../components/Snippet.astro";
import Comparison from "../components/Comparison.astro";

// All seven sections of site/README.md: hero, the warning, install, the
// Transaction walkthrough, the non-goals, the comparison, the footer.
//
// Everything in the terminal block below is real output. It was produced by
// building this repo's binary, seeding a state database with a baseline and
// two sightings of a second digest, and running the two commands against it.
// Nothing is trimmed, re-indented or invented. On a page whose whole argument
// is evidence, a mocked-up payload would be the one lie that mattered.

const COMPOSE = `services:
  ripen:
    image: ghcr.io/frankieramirez/ripen:latest
    command: ["daemon", "--config", "/config/policy.yaml"]
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    volumes:
      - ./policy.yaml:/config/policy.yaml:ro
      - ./data:/data
      - /srv/media/compose.yaml:/srv/media/compose.yaml   # only for compose backends`;

// The same twelve lines with the keys muted and the comment dimmed. The copy
// button hands over COMPOSE itself, so what lands in the clipboard is a file
// that parses rather than one carrying markup or a shell prompt.
const COMPOSE_MARKUP = `services:
  ripen:
    <span class="k">image</span>: ghcr.io/frankieramirez/ripen:latest
    <span class="k">command</span>: ["daemon", "--config", "/config/policy.yaml"]
    <span class="k">read_only</span>: true
    <span class="k">cap_drop</span>: [ALL]
    <span class="k">security_opt</span>: [no-new-privileges:true]
    <span class="k">volumes</span>:
      - ./policy.yaml:/config/policy.yaml:ro
      - ./data:/data
      - /srv/media/compose.yaml:/srv/media/compose.yaml   <span class="c"># only for compose backends</span>`;

const prompt = (command: string) =>
  `<span class="prompt">$</span> ${command}`;

const MONITOR = "ripen run --mode monitor --config policy.yaml";
const GO_INSTALL = "go install github.com/frankieramirez/ripen/cmd/ripen@latest";
const NIX_RUN = "nix run github:frankieramirez/ripen -- version";

// Section 4. The five steps are the README's, at the length the page can
// afford and the README cannot. This is the feature list -- the spec has no
// separate features section on purpose, because a Transaction explained in
// full is the answer to "how is this different from Watchtower" without
// naming Watchtower on the way.
const STEPS = [
  {
    name: "Observe",
    body: `Ripen asks what the orchestrator has deployed, what is running right
      now, and what the tag points at in the registry today. Those three
      answers are allowed to disagree, and the disagreement is the thing Ripen
      exists to notice. Anything it cannot read, it declines to guess at.`,
  },
  {
    name: "Baseline",
    body: `The first time Ripen sees a Service it writes down the digest that is
      running and stops there. Nothing to compare yet, so nothing to do. If the
      running digest cannot be proven, or an update is already waiting on a
      person, Ripen records nothing at all.`,
  },
  {
    name: "Ripen",
    body: `When the registry moves, the new digest becomes a Candidate and the
      clock starts on Ripen's own first sighting of it. A Candidate has to be
      seen twice and be older than the maturity window, a day by default,
      before it is eligible for anything. Most of a Candidate's life is spent
      waiting.`,
  },
  {
    name: "Apply",
    body: `In apply mode, on a stack that opted in, one Service. Ripen checks
      the health of every Service you configured a check for, pins that one
      image to <code>tag@sha256:…</code>, deploys, then checks all of them
      again. A sibling that was already unhealthy stops the update before it
      starts.`,
  },
  {
    name: "Roll back",
    body: `If the health check after the deploy fails, Ripen puts the Baseline
      digest back and opens the Circuit breaker. Apply stops, Proposals stop,
      and both stay stopped until a person clears the breaker with a reason
      that gets recorded. Monitoring and reads carry on the whole time.`,
  },
];

// Section 5. ROADMAP.md's headings, the README's framing, and the maintainer
// line the spec asks to be carried among them rather than tucked into a
// footer -- the smallness is the pitch, so it is stated in the same voice as
// everything else here.
const NON_GOALS = [
  {
    name: "The privileged Docker socket",
    body: `A socket that hands over the whole engine API is root on the host,
      and an updater with root on the host is a worse problem than an old
      image. A rootless user socket is a narrower connection and is supported.
      The privileged one refuses at config load, symlinks followed.`,
  },
  {
    name: "Unattended updating",
    body: `One Service per run, only where the policy opted in, only after a
      Candidate has matured. There will be no mode that sweeps a host. The
      latency is the feature.`,
  },
  {
    name: "Merging its own Proposals",
    body: `Ripen opens a pull request and stops. It will not merge, will not
      close, and will not deploy from Git. The review in the middle is why the
      Proposal exists.`,
  },
  {
    name: "Insecure TLS",
    body: `A CA file or an exact certificate fingerprint. There will be no
      <code>insecure_skip_verify</code>, no "just this once" flag, and no
      environment variable that turns verification off.`,
  },
  {
    name: "An agent or browser path to applying",
    body: `The MCP surface has no tool to apply an update or clear the breaker,
      and the Web UI has no button for either. Absent rather than disabled.
      Those are decisions a person makes at a terminal, with a reason that gets
      written down.`,
  },
  {
    name: "A second maintainer",
    body: `Ripen is one person's tool for their own machines, and the list above
      is short because that is what one person can hold in their head. Read it
      as the scope, and weigh it the way you would weigh any other dependency
      of that size.`,
  },
];
---

<BaseLayout
  title="Ripen — fail-closed image updates for Portainer and Compose"
  description="Ripen watches what :latest actually points at, waits for a new image to prove itself, and updates one service — only where you said it may."
>
  <header class="frame head">
    <Wordmark />
    <ThemeToggle />
  </header>

  <main>
    <section class="frame hero">
      <h1>A digest ripens.<br />You apply.</h1>

      <p class="lede">
        Tags move. Ripen watches what <code>:latest</code> actually points at,
        waits for a new image to prove itself, and updates one service — only
        where you said it may.
      </p>

      <div class="cta">
        <a class="run" href="#install">
          <span class="prompt">$</span> ripen run --mode monitor
        </a>
        <a class="secondary" href="https://github.com/frankieramirez/ripen">
          Source on GitHub
        </a>
      </div>

      <!--
        One session, two commands, in the order the argument needs them: the
        digest is ripe, and Ripen still will not touch it. The reveal runs
        once on load and never again; there is no loop, and no second chance
        to see it, which is the point of a page that is not a demo.
      -->
      <!--
        The reveal is switched on by this script, not by the stylesheet, and
        the script runs before the block below is parsed. The beats start at
        full opacity; only a browser that has run this line hides them to
        animate them in. Content that is invisible until an animation fires is
        content that a failed animation deletes.
      -->
      <script is:inline>
        document.documentElement.classList.add("motion");
      </script>

      <div class="evidence">
        <pre class="terminal"><code><span class="beat" style="--beat: 0"><span class="prompt">$</span> ripen candidates --pretty</span>
<span class="beat" style="--beat: 1">candidates:
  docker-compose/media: sha256:b91a7c2f5d8e4a1b6c3d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b
    <span class="k">first seen</span>: 2026-08-23T04:11:07Z
    <span class="k">last seen</span>: 2026-08-25T04:10:58Z
    <span class="k">observations</span>: 2
    <span class="k">mature</span>: <span class="ripe">true</span>
    <span class="k">mature at</span>: 2026-08-24T04:11:07Z</span>

<span class="beat" style="--beat: 2"><span class="prompt">$</span> ripen explain media --pretty</span>
<span class="beat" style="--beat: 3"><span class="k">stack</span>: media
<span class="k">backend</span>: docker-compose
<span class="k">enabled</span>: true
<span class="k">excluded</span>: false
<span class="k">mode</span>: monitor
<span class="k">circuit breaker</span>: closed
<span class="k">git path</span>: none
<span class="k">expected services</span>: jellyfin
services:
  docker-compose/media:
    <span class="k">enabled</span>: true
    <span class="k">auto apply</span>: false
    <span class="k">health</span>: http
      <span class="k">target</span>: http://127.0.0.1:8096/health
      <span class="k">accepted status</span>: 200
    <span class="k">baseline</span>: sha256:6f2c1d4e8a7b3c5d9e0f1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f
    <span class="k">candidate</span>: sha256:b91a7c2f5d8e4a1b6c3d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b
      <span class="k">first seen</span>: 2026-08-23T04:11:07Z
      <span class="k">last seen</span>: 2026-08-25T04:10:58Z
      <span class="k">observations</span>: 2
      <span class="k">mature</span>: <span class="ripe">true</span>
      <span class="k">mature at</span>: 2026-08-24T04:11:07Z
    <span class="k">pending proposal</span>: none</span>
<span class="beat" style="--beat: 4">    blockers:
      - the configured mode is monitor
      - auto_apply is off for this service</span></code></pre>
      </div>
    </section>

    <!--
      The warning is neutral on purpose. Amber means ripe, and it means only
      that; a warning painted in the one colour the page reserves for "ready"
      would teach the reader the wrong thing about every other amber token
      they meet. It gets weight from the rule and the type instead.
    -->
    <section class="frame warn">
      <div class="warn-box">
        <p class="label">Before you start</p>
        <div class="warn-body">
          <h2>Ripen recreates containers.<br />Start in monitor mode.</h2>
          <p>
            Monitor mode observes and records; it changes nothing. Read what it
            writes down for a few days, and only then decide whether any stack
            should carry <code>auto_apply: true</code>. Nothing moves until you
            say so twice — once in the policy file, once per stack.
          </p>
        </div>
      </div>
    </section>

    <section class="frame install" id="install">
      <h2>Install</h2>
      <p class="measure">
        Ripen needs a policy file and somewhere to keep its state. Nothing
        else. It never mounts the Docker socket, so most people run it as a
        container beside the stacks it watches.
      </p>

      <Snippet label="compose.yaml" markup={COMPOSE_MARKUP} copy={COMPOSE} />

      <p class="measure note">
        Three of those lines are the security argument rather than
        boilerplate: a read-only root, no capabilities, no privilege
        escalation. The volumes below them are the entire surface — a policy
        file, a directory for state, and the one compose file you told it
        about. There is no socket mount, and no flag that adds one.
      </p>

      <Snippet
        label="Then watch, and only watch"
        markup={prompt(MONITOR)}
        copy={MONITOR}
      />

      <details class="other">
        <summary><span class="label">Other ways to install</span></summary>
        <div class="other-body">
          <Snippet label="Go" markup={prompt(GO_INSTALL)} copy={GO_INSTALL} />
          <Snippet label="Nix" markup={prompt(NIX_RUN)} copy={NIX_RUN} />
          <p class="measure note">
            Or take a signed archive from the <a
              href="https://github.com/frankieramirez/ripen/releases">releases
              page</a>. Every release is built by the tag it is named after and
            ships with its checksums.
          </p>
        </div>
      </details>
    </section>

    <!--
      The centre of gravity. There is deliberately no features section on the
      page; a Transaction explained in full is the feature list, and it
      answers "how is this different from Watchtower" three sections before
      Watchtower is named.
    -->
    <section class="frame transaction" id="how-it-works">
      <h2>How a Transaction works</h2>
      <p class="measure">
        Every run is one Transaction, and it either finishes or it undoes
        itself. There is no partial state to clean up afterwards, and no step
        that acts on something the step before it could not prove.
      </p>

      <ol class="steps">
        {
          STEPS.map((step, index) => (
            <li>
              <p class="step-head">
                <span class="step-index label">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="step-name">{step.name}</span>
              </p>
              <p class="measure" set:html={step.body} />
            </li>
          ))
        }
      </ol>

      <p class="measure note">
        Git-backed stacks swap step four for a Proposal: one deterministic pull
        request that pins the digest, which Ripen opens and never merges.
      </p>
    </section>

    <!--
      Placed before the comparison on purpose. A reader who has just been told
      what Ripen refuses to do reads the socket row below as a choice someone
      made, rather than as a flaw being scored.
    -->
    <section class="frame limits" id="limits">
      <h2>What it will not do</h2>
      <p class="measure">
        These are decided. An issue asking for one is closed with a link to the
        same list in <a
          href="https://github.com/frankieramirez/ripen/blob/main/ROADMAP.md"
          >ROADMAP.md</a
        >, which also has the things that may come later.
      </p>

      <dl class="limit-list">
        {
          NON_GOALS.map((goal) => (
            <div class="limit">
              <dt>{goal.name}</dt>
              <dd set:html={goal.body} />
            </div>
          ))
        }
      </dl>
    </section>

    <section class="frame compare" id="comparison">
      <h2>Ripen, Watchtower, Diun</h2>
      <p class="measure">
        Both of these do the job they chose, and both say so in their own
        words. Watchtower's documentation says they do not recommend using it
        in a commercial or production environment. Diun's author has said since
        2019 that it "is not intended to update containers but only to send
        notifications when an image is updated on a registry." Neither is a
        worse Ripen. They answer a different question about the same problem,
        and the table is where the answers separate.
      </p>

      <Comparison />
    </section>
  </main>

  <footer class="frame foot">
    <p class="privacy">
      Cloudflare Web Analytics counts the pages read here. It sets no cookie
      and writes nothing to your browser.
    </p>
    <nav class="foot-links" aria-label="Elsewhere">
      <a href="https://github.com/frankieramirez/ripen">GitHub</a>
      <a href="/docs/">Docs</a>
      <a href="https://github.com/frankieramirez/ripen/releases">Changelog</a>
      <a
        href="https://github.com/frankieramirez/ripen/blob/main/SECURITY.md"
        >Security</a
      >
      <a href="https://github.com/frankieramirez/ripen/blob/main/LICENSE"
        >Apache-2.0</a
      >
    </nav>
  </footer>
</BaseLayout>

<style>
  .frame {
    max-width: var(--frame);
    margin: 0 auto;
    padding-left: var(--space-6);
    padding-right: var(--space-6);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding-top: var(--space-8);
  }

  /* --- 1. Hero ------------------------------------------------------ */

  .hero {
    padding-top: var(--space-24);
    padding-bottom: var(--space-16);
  }

  .lede {
    margin-top: var(--space-6);
    font-size: 1.25rem;
    max-width: var(--measure);
  }

  /*
   * The primary action sits above the evidence, not below it. The block
   * beneath runs thirty-two lines because that is what the two commands
   * really print, which puts anything after it well past the fold; the
   * zero-risk command is the one thing that cannot afford to be down there.
   */
  .cta {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-top: var(--space-8);
  }

  .run {
    font-family: var(--font-mono);
    font-size: var(--step-body);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
  }

  .run:hover {
    border-color: var(--muted);
  }

  .run .prompt {
    color: var(--muted);
    user-select: none;
  }

  .secondary {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--muted);
  }

  .secondary:hover {
    color: var(--ink);
  }

  .evidence {
    margin-top: var(--space-12);
  }

  /* --- 2. The warning ----------------------------------------------- */

  .warn {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .warn-box {
    border: 1px solid var(--border);
    border-left: 3px solid var(--muted);
    background: var(--surface);
    padding: var(--space-6);
  }

  .warn-box h2 {
    font-size: var(--step-heading);
    line-height: 1.4;
    letter-spacing: 0;
    margin-bottom: var(--space-3);
  }

  .warn-body p {
    margin: 0;
  }

  /* --- 3. Install --------------------------------------------------- */

  .install {
    padding-bottom: var(--space-24);
  }

  .install h2 {
    margin-bottom: var(--space-6);
  }

  .measure {
    max-width: var(--measure);
  }

  .note {
    color: var(--muted);
    font-size: var(--step-small);
    margin-top: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .other {
    border-top: 1px solid var(--border);
    padding-top: var(--space-6);
  }

  .other summary {
    cursor: pointer;
    list-style: none;
  }

  .other summary::-webkit-details-marker {
    display: none;
  }

  .other summary .label {
    color: var(--muted);
  }

  .other summary:hover .label {
    color: var(--ink);
  }

  /* A closed disclosure that looks like a heading is a dead end; the arrow
     is the only thing telling the reader there is more behind it. */
  .other summary .label::before {
    content: "+ ";
  }

  .other[open] summary .label::before {
    content: "− ";
  }

  .other-body {
    padding-top: var(--space-6);
  }

  .terminal .c {
    color: var(--muted);
  }

  /* --- 4. How a Transaction works ----------------------------------- */

  .transaction {
    border-top: 1px solid var(--border);
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .transaction h2 {
    margin-bottom: var(--space-6);
  }

  /*
   * The steps hang off one rule, which is the only thing on the page drawing
   * a sequence. Numbers rather than icons: the order is the argument, and a
   * row of glyphs beside it would be the feature grid this page was written
   * to avoid.
   */
  .steps {
    list-style: none;
    margin: var(--space-12) 0 0;
    padding: 0 0 0 var(--space-6);
    border-left: 1px solid var(--border);
  }

  .steps > li {
    padding-bottom: var(--space-8);
  }

  .steps > li:last-child {
    padding-bottom: 0;
  }

  .step-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }

  /* The number reads with the name, not out in the gutter beside the rule.
     Hung out there it lost the name it belongs to and picked up the rule
     instead, which made it look like a stray mark rather than an index. */
  .step-index {
    font-size: var(--step-small);
    flex: none;
  }

  .step-name {
    font-family: var(--font-mono);
    font-size: var(--step-heading);
    font-weight: 500;
    color: var(--ink);
  }

  /* --- 5. What it will not do --------------------------------------- */

  .limits {
    border-top: 1px solid var(--border);
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .limits h2 {
    margin-bottom: var(--space-6);
  }

  .limit-list {
    margin: var(--space-12) 0 0;
  }

  .limit {
    padding-bottom: var(--space-8);
  }

  .limit:last-child {
    padding-bottom: 0;
  }

  .limit dt {
    font-family: var(--font-mono);
    font-size: var(--step-heading);
    font-weight: 500;
    margin-bottom: var(--space-2);
  }

  .limit dd {
    margin: 0;
    max-width: var(--measure);
  }

  /* --- 6. Comparison ------------------------------------------------ */

  .compare {
    border-top: 1px solid var(--border);
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .compare h2 {
    margin-bottom: var(--space-6);
  }

  .compare > .measure {
    margin-bottom: var(--space-12);
  }

  /* --- 7. Footer ---------------------------------------------------- */

  .foot {
    border-top: 1px solid var(--border);
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    font-size: var(--step-small);
  }

  .privacy {
    color: var(--muted);
    margin: 0;
    max-width: 28rem;
  }

  /* Row-gap is tighter than column-gap on purpose: below about 26rem the
     five links wrap, and a wide row-gap leaves the last one looking stranded
     on a line of its own rather than reading as part of one block. */
  .foot-links {
    display: flex;
    gap: var(--space-3) var(--space-6);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--step-small);
  }

  .foot-links a {
    color: var(--muted);
    text-decoration: none;
  }

  .foot-links a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--border);
  }

  /*
   * The orchestrated load: five beats over about a second, once. Each beat is
   * a group of lines that belong together -- a command, then its output -- so
   * the block assembles the way a session does rather than typing itself out
   * character by character, which would be theatre.
   *
   * The lines are in the document either way, and visible by default. The
   * animation only moves them; with JavaScript off, CSS unloaded, or motion
   * reduced, the reader gets the finished block immediately, which is the
   * version that matters.
   */
  :global(html.motion) .beat {
    animation: settle 320ms ease-out both;
    animation-delay: calc(var(--beat) * 200ms);
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.motion) .beat {
      animation: none;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      padding-top: var(--space-12);
    }

    h1 {
      /* The break is set for the desktop measure; at phone width the line
         wraps on its own and the manual break leaves a short first line. */
      display: block;
    }

    .cta {
      align-items: stretch;
      flex-direction: column;
      gap: var(--space-4);
    }

    .run {
      text-align: center;
    }

    /* One row at desktop, stacked here -- the links would otherwise wrap into
       a ragged second line under a privacy note they are not part of. */
    .foot {
      flex-direction: column;
      gap: var(--space-8);
    }
  }
</style>

<script>
  /*
   * One delegated listener for every copy button on the page.
   *
   * The button copies the `data-copy` string rather than the block's own text
   * because the block carries a `$` prompt that must not travel with it: a
   * reader who pastes `$ ripen run` into a shell gets an error, and blames
   * the page.
   *
   * The clipboard API is absent on an insecure origin and can be refused
   * outright even where it exists. Both paths tell the reader to copy it
   * themselves rather than leaving a button that does nothing and says
   * nothing.
   */
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest<HTMLElement>("[data-copy]");
    if (!button) return;

    const text = button.dataset.copy;
    const feedback = button.querySelector<HTMLElement>("[data-copy-text]");
    if (!text || !feedback) return;

    const say = (message: string) => {
      feedback.textContent = message;
      window.setTimeout(() => {
        feedback.textContent = "Copy";
      }, 1600);
    };

    // `navigator.clipboard` is absent on an insecure origin, and optional
    // chaining would short-circuit the whole call including the .then --
    // leaving a button that does nothing and says nothing. Check for it.
    if (!navigator.clipboard) {
      say("Select and copy");
      return;
    }

    navigator.clipboard.writeText(text).then(
      () => say("Copied"),
      () => say("Select and copy"),
    );
  });
</script>
