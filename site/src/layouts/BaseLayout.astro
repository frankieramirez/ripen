---
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

/*
 * The link preview. Absolute, because a crawler resolves it against nothing
 * -- a root-relative href is the standard way to ship a card with no image.
 *
 * `Astro.site` is ripen.dev, so on the workers.dev deploy these point at a
 * host that is still dark. That is the same choice the canonical link above
 * already makes, and it is the right one: the preview a reader shares has to
 * name the site, not the address it happened to be built for.
 */
const OG_IMAGE = new URL("/og.png", Astro.site);
const OG_ALT =
  "A digest ripens. You apply. — ripen.dev, set in white monospace on " +
  "near-black beside Ripen's two-circle mark.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!--
      The link preview. The card is one static image for the whole site,
      dark whichever theme the reader keeps, because it renders on somebody
      else's surface and answers no media query there.

      There is no `twitter:title` or `twitter:description`: X reads the
      `og:` pair when the `twitter:` one is absent, and a second copy of the
      same two strings is a second place for them to fall out of step.

      No `theme-color` either. It can only answer `prefers-color-scheme`, and
      this site has a toggle that outranks the system -- so the tag would be
      right in two of the three theme states and wrong in the third, which is
      worse than colouring nothing.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ripen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content={OG_ALT} />

    <!--
      Icons. The SVG is the real one: it carries its own light and dark
      variants, so the mark is legible against either browser chrome without
      shipping two files.

      The 32px PNG is the fallback for anything that will not take an SVG
      icon, and it is deliberately the light-theme cut -- a fallback cannot
      answer a media query, so it takes the side that renders on the pale tab
      strips that are still the default nearly everywhere.

      The Apple touch icon is opaque, on `ground`: iOS composites a
      transparent icon onto whatever it likes and the mark would come back
      floating on white.
    -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!--
      The no-flash path, and the reason it is inline and first.

      A theme that repaints after first paint is very visible on a
      warm-near-black page: the reader gets a white flash and then the site.
      So the stored choice is written onto <html> before any stylesheet is
      parsed, which means it cannot be a module, cannot be deferred, and
      cannot live in a component further down the document.

      Absent a stored choice, nothing is written and the CSS falls through to
      prefers-color-scheme. Three states -- explicit dark, explicit light, and
      "follow the system" -- and the absent attribute is the third one rather
      than a fourth value to keep in sync.

      Wrapped in try/catch because localStorage throws outright in some
      privacy modes, and a theme preference is not worth a blank page.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("ripen-theme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.dataset.theme = stored;
          }
        } catch (e) {}
      })();
    </script>

    <!--
      Preloaded because the two faces are the page. The mono is the display
      voice and the serif is every word of prose, so both are needed for the
      first paint that matters; the italic and the 500 weight are not, and are
      left to be fetched normally.
    -->
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />
  </body>
</html>
