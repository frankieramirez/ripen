{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "const": "candidates",
      "type": "string"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "backend": {
                "type": "string"
              },
              "digest": {
                "type": "string"
              },
              "first_seen": {
                "type": "string"
              },
              "last_seen": {
                "type": "string"
              },
              "mature": {
                "type": "boolean"
              },
              "mature_at": {
                "type": "string"
              },
              "observations": {
                "type": "integer"
              },
              "service": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stack": {
                "type": "string"
              }
            },
            "required": [
              "backend",
              "digest",
              "first_seen",
              "last_seen",
              "mature",
              "mature_at",
              "observations",
              "service",
              "stack"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "candidates"
      ],
      "type": "object"
    },
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "command",
    "occurred_at",
    "ok"
  ],
  "title": "ripen candidates response",
  "type": "object"
}
